rules_version = '2';

// NOTE: this repo previously had no firestore.rules under version control —
// whatever was configured in the Firebase console is the actual source of
// truth today. Review these against the console rules before deploying
// (`firebase deploy --only firestore:rules`) so you don't accidentally
// loosen or break existing access.
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    // Mirrors the allowlist in lib/core/auth/admin_access.dart and
    // functions/src/adminAccess.ts. All three are generated from the same
    // tenants/<tenantId>/tenant.json by scripts/apply_tenant.dart — edit the
    // json and re-run that script, don't hand-edit any of the three. Do not
    // remove the marker comments below; the script replaces everything
    // between them.
    function isAdmin() {
      return isSignedIn() && request.auth.token.email in [
        // TENANT-ADMIN-EMAILS:START
        'bharathbiomedpharma@gmail.com',
        'sudhakar.gotte@bharathbiomedpharma.com'
        // TENANT-ADMIN-EMAILS:END
      ];
    }

    // Fully separate from isAdmin() above — this is the new designation/
    // permission hierarchy (see functions/src/hierarchy.ts), which controls
    // Order-style visibility, not access to the admin panel. Reads
    // the caller's own denormalized `permissions` (copied from their
    // assigned designation onto their Users doc by the hierarchy trigger).
    function hasPermission(name) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/Users/$(request.auth.uid)).data.get('permissions', []).hasAny([name]);
    }

    function hasGlobalVisibility() {
      return hasPermission('view_global_data');
    }

    // "Office Admin": the hardcoded admin allowlist, or a real designation
    // whose denormalized category is office_administration (see
    // Designation/DesignationCategory). Gates agency/pharmacy
    // create+deactivate and EntityChangeRequest review — deliberately not
    // the same thing as isAdmin(), since the business wants any Office
    // Administration designation to have this, not just the two allowlisted
    // emails.
    function isOfficeAdmin() {
      return isAdmin() ||
        (isSignedIn() &&
          get(/databases/$(database)/documents/Users/$(request.auth.uid)).data.get('category', '') == 'office_administration');
    }

    // Whether the caller is somewhere in employeeUid's reporting chain (i.e.
    // a manager reading someone in their own downline) — same relationship
    // already used by the Users/{uid} rule below, reused here so a manager's
    // "my team" screens (usage/location, visit logs) work without needing
    // isAdmin() or view_global_data.
    function isInDownlineOf(employeeUid) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/Users/$(employeeUid)).data.get('reportingChainUids', []).hasAny([request.auth.uid]);
    }

    // Catalog data: every signed-in user (reps and admin alike) can read it
    // to sync their device; only the admin can write it directly. Sales
    // reps go through Cloud Functions for nothing here — direct writes from
    // the admin app are fine since only the admin account can perform them.
    // The one exception is stock adjustment (ManageInventoryScreen): an
    // Office Admin may update *only* stockQuantity, a narrower path than
    // full product edit — everything else (name/info/departments/image)
    // stays admin-only. dispatchOrder's own stockQuantity decrement uses
    // the Admin SDK and bypasses these rules entirely.
    match /Products/{productId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
      allow update: if isOfficeAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stockQuantity']);
    }

    // Batch/expiry tracking for a product's stock (see
    // domain/models/product_batch.dart). Inventory-management data, not
    // needed by the sales/MR side, so read is scoped to admin/Office Admin
    // rather than every signed-in user the way Products itself is. Both
    // `addBatch`/`deleteBatch` pair a write here with a `stockQuantity`
    // update on the parent Product in the same client transaction — that
    // paired write is separately gated by the narrower Office Admin rule
    // on `Products/{productId}` above.
    match /Products/{productId}/Batches/{batchId} {
      allow read, write: if isOfficeAdmin();
    }

    match /Department/{departmentDoc} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Designation options (e.g. "Medical Representative", "Area Business
    // Manager") admin assigns to employees when creating their profile.
    // Purely an admin-management concern, so unlike Products/Department
    // it isn't read by the sales/reps side of the app at all.
    match /Designations/{designationId} {
      allow read, write: if isAdmin();
    }

    // Medical Representative profiles. The admin may read the whole list
    // (to show it in "Manage Employees"); an MR may read their own doc,
    // any doc in their reporting chain's downline (reportingChainUids is
    // the full ancestor list per doc, so this is a manager reading anyone
    // in their subtree), or anyone at all if they hold view_global_data.
    // Nobody writes here directly — creation, edits (admin or
    // self-service), deletion, etc. all go through Cloud Functions
    // (createEmployee/updateEmployee/deleteEmployee/
    // updateMyEmployeeProfile/...), which use the Admin SDK and bypass
    // these rules.
    match /Users/{uid} {
      allow read: if isAdmin()
        || (isSignedIn() && request.auth.uid == uid)
        || (isSignedIn() && resource.data.get('reportingChainUids', []).hasAny([request.auth.uid]))
        || hasGlobalVisibility();
      allow write: if false;
    }

    // The admin's own profile (name/photo/mobile/DOB) — there's no `Users`
    // doc for the admin (they're just an allowlisted email, see isAdmin()
    // above), so this is its own doc the admin edits directly. Safe as a
    // direct client write since it's the admin's own low-sensitivity data
    // and isAdmin() + the uid match already fully trust this caller.
    match /AdminProfile/{uid} {
      allow read, write: if isAdmin() && request.auth.uid == uid;
    }

    // In-app notifications for the admin (currently only ever "an MR's date
    // of birth changed" — see the onEmployeeDobChanged trigger in
    // functions/src/index.ts). Only that trigger's Admin SDK write ever
    // creates one (which bypasses rules), so client `create`/`delete` are
    // both denied; the admin can still mark one read via `update`.
    match /AdminNotifications/{notificationId} {
      allow read, update: if isAdmin();
      allow create, delete: if false;
    }

    // MR app-usage sessions (open/close timestamps, duration, location at
    // open) — see lib/features/tracking/. Uploaded directly by the MR's own
    // client (not via a Cloud Function, since this is just an employee
    // reporting their own usage, not a privileged operation), but only ever
    // about themselves: the doc's employeeUid must match the caller's own
    // uid, so a compromised client can't write a session claiming to be
    // someone else. The admin, a view_global_data holder, or this employee's
    // own manager can read the log; nobody can update
    // (beyond the one retry-safe overwrite of their own doc) or delete it —
    // this is meant to be an append-only record.
    match /UsageSessions/{sessionId} {
      allow read: if isAdmin() || hasGlobalVisibility() || isInDownlineOf(resource.data.employeeUid);
      allow create: if isSignedIn() && request.resource.data.employeeUid == request.auth.uid;
      // The app never actually rewrites an existing session doc once it's
      // synced (see UsageSessionRepository.uploadPending), but the rule
      // still has to cover the case since the client writes with `set`, not
      // `create`. Lock the fields that describe when/where the session
      // started so a compromised client can't rewrite session history —
      // only closedAt/durationSeconds/uploadedAt may change after creation.
      allow update: if isSignedIn()
        && resource.data.employeeUid == request.auth.uid
        && request.resource.data.employeeUid == request.auth.uid
        && request.resource.data.openedAt == resource.data.openedAt
        && request.resource.data.latitude == resource.data.latitude
        && request.resource.data.longitude == resource.data.longitude;
      allow delete: if false;
    }

    // Doctors an MR visits. Admin has full read/write (create/edit outright,
    // assign/reassign an MR). An MR may only read the doctors currently
    // assigned to them; they never write here directly — their proposed
    // creates/edits go through DoctorChangeRequests instead and are only
    // ever applied here by the reviewDoctorChangeRequest Cloud Function
    // (Admin SDK, bypasses these rules) once approved.
    match /Doctors/{doctorId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.assignedMrUid == request.auth.uid);
      allow write: if isAdmin();
    }

    // An MR's proposed doctor create/edit, awaiting review. The MR may
    // create their own request and read it back; review (via the
    // reviewDoctorChangeRequest Cloud Function) is the hardcoded admin
    // allowlist or any approve_requests holder (e.g. an Area Business
    // Manager and above — deliberately category-agnostic, unlike
    // isOfficeAdmin() below) — client update/delete are both denied either
    // way, since only that Cloud Function may change status or apply it.
    match /DoctorChangeRequests/{requestId} {
      allow read: if isAdmin() || hasPermission('approve_requests') ||
        (isSignedIn() && resource.data.requestedByUid == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.requestedByUid == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update, delete: if false;
    }

    // One doc per MR holding their recurring weekly visiting schedule, plus
    // a beat/route-plan approval workflow on top (see
    // domain/models/doctor_visit_plan.dart's VisitPlanStatus). The admin
    // can always read/edit any MR's plan (e.g. while reassigning doctors);
    // a manager (global visibility, or this MR being in their downline)
    // can read it too, for the approval screen.
    match /DoctorVisitPlans/{mrUid} {
      allow read: if isAdmin() || hasGlobalVisibility() || (isSignedIn() && request.auth.uid == mrUid) ||
        isInDownlineOf(mrUid);

      // The MR's own content edits (including the initial create, and
      // submitting for approval by setting status to 'pending') — blocked
      // while a manager review is already in flight ('pending') so a
      // decision can't be raced against a content edit; the MR can resume
      // editing once it's approved or rejected, and (per
      // DoctorVisitPlan.copyWithWeekday's doc comment) that resumed editing
      // deliberately does NOT reset an existing 'approved'/'rejected'
      // status back to 'draft' — so the update rule below must allow the
      // status to stay exactly what it already was. What it must NOT allow
      // is the MR jumping the status to 'approved'/'rejected' themselves:
      // the only two statuses a content-edit write may ever *produce* are
      // 'draft' (create) and either "unchanged" or 'pending' (update) —
      // only the second `allow update` below (the manager's decision) can
      // ever set 'approved'/'rejected'.
      allow create: if isAdmin() ||
        (isSignedIn() && request.auth.uid == mrUid &&
          request.resource.data.get('status', 'draft') in ['draft', 'pending']);
      allow update: if isAdmin() ||
        (isSignedIn() && request.auth.uid == mrUid && resource.data.get('status', 'draft') != 'pending' &&
          (request.resource.data.get('status', 'draft') == resource.data.get('status', 'draft') ||
            request.resource.data.get('status', 'draft') == 'pending'));

      // A manager's approve/reject decision on a submitted plan — mirrors
      // Orders/ExpenseClaims: only the review fields change, and only
      // while pending.
      allow update: if isSignedIn()
        && hasPermission('approve_requests')
        && (hasGlobalVisibility() || isInDownlineOf(mrUid))
        && resource.data.get('status', 'draft') == 'pending'
        && request.resource.data.status in ['approved', 'rejected']
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'approvedByUid', 'approvedAt', 'rejectedReason']);

      allow delete: if false;
    }

    // Append-only daily "who I visited today and how it went" records —
    // same shape/rules as UsageSessions above.
    match /DoctorVisitLogs/{logId} {
      allow read: if isAdmin() || hasGlobalVisibility() || isInDownlineOf(resource.data.mrUid);
      allow create: if isSignedIn() && request.resource.data.mrUid == request.auth.uid;
      allow update, delete: if false;
    }

    // Retail Chemist Prescription Audit entries — same shape/rules as
    // DoctorVisitLogs above (append-only, admin/global/downline read, own-
    // mrUid create only).
    match /RcpaEntries/{entryId} {
      allow read: if isAdmin() || hasGlobalVisibility() || isInDownlineOf(resource.data.mrUid);
      allow create: if isSignedIn() && request.resource.data.mrUid == request.auth.uid;
      allow update, delete: if false;
    }

    // UCPMP compliance records (what an MR gave a doctor) — same shape as
    // RcpaEntries above: append-only, own-mrUid create only.
    match /ComplianceLogs/{logId} {
      allow read: if isAdmin() || hasGlobalVisibility() || isInDownlineOf(resource.data.mrUid);
      allow create: if isSignedIn() && request.resource.data.mrUid == request.auth.uid;
      allow update, delete: if false;
    }

    // Reminders for the admin or an MR. An MR may only ever create/own a
    // reminder for themselves; the admin may create one for themselves or
    // assign one to any MR. Marking one complete/deleting it is restricted
    // to whoever owns it (or the admin).
    match /Reminders/{reminderId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.ownerUid == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.createdByUid == request.auth.uid
        && (isAdmin() || request.resource.data.ownerUid == request.auth.uid);
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.ownerUid == request.auth.uid);
    }

    // Distributors/stockists. Every signed-in user can read (both agency
    // list screens and MR order-booking need the full list); only an Office
    // Admin can create outright or deactivate; updating is also open to
    // anyone holding manage_agencies. An MR's proposed new agency instead
    // goes through EntityChangeRequests, applied here only by the
    // reviewEntityChangeRequest Cloud Function.
    match /Agencies/{agencyId} {
      allow read: if isSignedIn();
      allow create, delete: if isOfficeAdmin();
      allow update: if isOfficeAdmin() || hasPermission('manage_agencies');
    }

    // Pharmacies/chemists — identical shape to Agencies above.
    match /Pharmacies/{pharmacyId} {
      allow read: if isSignedIn();
      allow create, delete: if isOfficeAdmin();
      allow update: if isOfficeAdmin() || hasPermission('manage_agencies');
    }

    // An MR's proposed new agency/pharmacy, awaiting review — same shape as
    // DoctorChangeRequests above. Reviewable by an Office Admin
    // unconditionally (isOfficeAdmin(), since agencies/pharmacies aren't
    // gated to the hardcoded admin allowlist the way Doctors is), or by any
    // approve_requests holder regardless of category — a second,
    // independent path added so a senior field designation (e.g. an Area
    // Business Manager and above) can review these too.
    match /EntityChangeRequests/{requestId} {
      allow read: if isOfficeAdmin() || hasPermission('approve_requests') ||
        (isSignedIn() && resource.data.requestedByUid == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.requestedByUid == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update, delete: if false;
    }

    // An MR-placed order against an Agency. Created directly by the MR
    // (low-privilege — only their own createdByUid, must start `pending`).
    // Approve/reject is also a direct write, but gated to approve_orders +
    // (global visibility or being somewhere in the creator's reporting
    // chain), restricted to only touch the review fields, and only while
    // still pending (so it can't be replayed or used to un-approve/
    // un-reject after the fact). Dispatch (stock decrement) always goes
    // through its Cloud Function — see dispatchOrder — which uses the
    // Admin SDK and bypasses these rules, so there's no client update path
    // to that status here. `delivered` is the exception: a direct,
    // ownership-scoped write by the order's own creator only, once
    // dispatched — invoicing/payment are handled entirely offline outside
    // the app, so there's no further Cloud-Function-gated status after this.
    match /Orders/{orderId} {
      allow read: if isAdmin()
        || hasGlobalVisibility()
        || resource.data.createdByUid == request.auth.uid
        || isInDownlineOf(resource.data.createdByUid);
      allow create: if isSignedIn()
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if isSignedIn()
        && hasPermission('approve_orders')
        && (hasGlobalVisibility() || isInDownlineOf(resource.data.createdByUid))
        && resource.data.status == 'pending'
        && request.resource.data.status in ['approved', 'rejected']
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'approvedByUid', 'approvedAt', 'rejectedReason']);
      allow update: if isSignedIn()
        && resource.data.createdByUid == request.auth.uid
        && resource.data.status == 'dispatched'
        && request.resource.data.status == 'delivered'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'deliveredAt']);
      allow delete: if false;
    }

    // A monthly order-value target an RM-or-above sets for one of their
    // reporting-chain downline. Doc id is `{employeeUid}_{period}` (an
    // upsert key, not enforced here). The employee it's for may always read
    // their own; creating/updating requires manage_targets (or global
    // visibility/admin) AND the target employee being in the caller's own
    // downline — a manager can't set a target for someone outside their
    // chain even if they hold the permission.
    match /SalesTargets/{targetId} {
      allow read: if isAdmin()
        || hasGlobalVisibility()
        || hasPermission('manage_targets')
        || (isSignedIn() && resource.data.employeeUid == request.auth.uid);
      allow create, update: if isSignedIn()
        && (isAdmin() || hasGlobalVisibility() || hasPermission('manage_targets'))
        && (isAdmin() || hasGlobalVisibility() || isInDownlineOf(request.resource.data.employeeUid));
      allow delete: if false;
    }

    // An MR's TA/DA expense claim — same shape as Orders above, minus the
    // dispatch/invoice steps (a claim has no further fulfillment once
    // approved, so 'approved'/'rejected' are both terminal here).
    match /ExpenseClaims/{claimId} {
      allow read: if isAdmin()
        || hasGlobalVisibility()
        || resource.data.mrUid == request.auth.uid
        || isInDownlineOf(resource.data.mrUid);
      allow create: if isSignedIn()
        && request.resource.data.mrUid == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if isSignedIn()
        && hasPermission('approve_expenses')
        && (hasGlobalVisibility() || isInDownlineOf(resource.data.mrUid))
        && resource.data.status == 'pending'
        && request.resource.data.status in ['approved', 'rejected']
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'approvedByUid', 'approvedAt', 'rejectedReason']);
      allow delete: if false;
    }

    // This device's current FCM token, used by Cloud Functions to target a
    // push at one specific person (reminder-due, doctor-request-reviewed)
    // rather than a broadcast topic. Each user may only ever write their own
    // token; nobody reads it back client-side — only the Admin SDK does.
    match /DeviceTokens/{uid} {
      allow read: if false;
      allow write: if isSignedIn() && request.auth.uid == uid;
    }
  }
}
