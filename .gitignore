# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
android/app/.cxx/

# google-services.json / GoogleService-Info.plist are tracked deliberately:
# they hold public client identifiers (not secrets — see Firebase's docs),
# and the app can't be built from a fresh clone without them.

# Test coverage output (flutter test --coverage)
coverage/

# Store screenshots generated by integration_test/app_screenshot_test.dart
/screenshots/
